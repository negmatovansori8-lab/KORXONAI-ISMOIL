# Database — Neon (use the DIRECT connection, not the -pooler host)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxxx.region.aws.neon.tech/neondb?sslmode=require

# Auth
JWT_SECRET=generate-a-long-random-secret
JWT_EXPIRES_IN=12h

# Server (Railway sets PORT automatically)
PORT=4000
NODE_ENV=production

# Frontend origins, comma-separated (Railway web URL)
CORS_ORIGIN=https://YOUR-WEB.up.railway.app,http://localhost:3000,http://localhost:3001

# Telegram Mini App (optional)
TELEGRAM_BOT_TOKEN=
MINIAPP_URL=https://YOUR-WEB.up.railway.app

# Seed demo users on first empty database (ceo@oilenterprise.tj / CEO@2026)
SEED_ON_BOOT=true

UPLOAD_DIR=./uploads
BACKUP_DIR=./backups
